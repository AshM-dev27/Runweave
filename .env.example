# Local startup generates a random API key when this is blank.
API_KEY=
DATABASE_URL=postgresql+asyncpg://agents:local-development-only@localhost:5432/agents
DATABASE_SCHEMA=public
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=agents-v1
MAX_ACTIVE_RUNS=20
# Optional shared persistent blob directory. Empty retains inline database storage.
ARTIFACT_STORAGE_PATH=
ARTIFACT_MAX_BYTES=16777216
ARTIFACT_STORAGE_BYTES=536870912
ARTIFACT_RUN_BYTES=67108864
MCP_URL=http://localhost:8001/mcp
# Optional providers: default fake-model tests need neither credential.
OPENAI_API_KEY=
# Official OpenAI endpoint only; false restores default network routing.
OPENAI_FORCE_IPV4=true
ANTHROPIC_API_KEY=
# Optional hosted browser tool; worker only, each task requires approval.
BROWSER_USE_API_KEY=
# Optional bounded E2B Python capability; worker only.
E2B_API_KEY=
# Optional OTLP HTTP collector base URL; no external telemetry by default.
OTEL_EXPORTER_OTLP_ENDPOINT=
PYDANTIC_AI_NO_BANNER=1
