# Copy to an ignored .env.production.local and chmod 600. Never commit filled values.
RUNWEAVE_IMAGE=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SCHEMA=public
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=runweave-production
TASK_QUEUE=runweave-production
API_KEY=
API_PORT=18000
MAX_ACTIVE_RUNS=20
# Same private persistent directory mounted by the API and every worker; owned by UID 10001.
ARTIFACT_STORAGE_HOST_PATH=/srv/runweave/artifacts
ARTIFACT_MAX_BYTES=16777216
ARTIFACT_STORAGE_BYTES=536870912
ARTIFACT_RUN_BYTES=67108864
# Absolute path, readable by the operator; Compose loads it into the worker only.
WORKER_ENV_FILE=
